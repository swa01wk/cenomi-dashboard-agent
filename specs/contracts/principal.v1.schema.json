{
  "$id": "https://cenomi.local/contracts/principal.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The signed-in principal returned by GET /api/v1/me and POST /api/v1/auth/dev/sign-in (ARCH-R077). The client uses it only for presentation; authorization is enforced server-side (ARCH-R046). Business keys in grants are provisional until CF-1 confirms them against the seed (ARCH-R078). Bootstrap contract, frozen by CF-0.",
  "examples": [
    {
      "displayName": "Central regional manager",
      "grants": [
        {
          "kind": "REGIONS",
          "regionKeys": [
            "central"
          ]
        }
      ],
      "permissions": [],
      "persona": "admin",
      "principalId": "p_central_manager",
      "role": "REGIONAL_ADMIN",
      "sessionExpiresAt": "2026-10-22T22:00:00Z"
    },
    {
      "displayName": "Lumen Home (lease T-31206)",
      "grants": [
        {
          "kind": "TENANT_LEASES",
          "leaseKeys": [
            "T-31206"
          ]
        }
      ],
      "permissions": [],
      "persona": "tenant",
      "principalId": "p_tenant_t31206",
      "role": "TENANT_LEASE_CONTACT",
      "sessionExpiresAt": "2026-10-22T22:00:00Z"
    },
    {
      "displayName": "No-access test principal",
      "grants": [],
      "permissions": [],
      "persona": "admin",
      "principalId": "p_no_grants",
      "role": "REGIONAL_ADMIN",
      "sessionExpiresAt": "2026-10-22T22:00:00Z"
    }
  ],
  "properties": {
    "displayName": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Displayname",
      "type": "string"
    },
    "grants": {
      "description": "Union of scope grants. Empty means no access (deny by default, ARCH-R079). ALL is only ever an explicit grant (ARCH-R080).",
      "items": {
        "$ref": "scope_decision.v1.schema.json#/$defs/scope"
      },
      "maxItems": 20,
      "title": "Grants",
      "type": "array"
    },
    "permissions": {
      "description": "Permission names from specs/authorization/permissions.yaml. Empty in M0 (the matrix arrives in PR-M1).",
      "items": {
        "pattern": "^[a-z][a-z0-9_]*(:[a-zA-Z0-9_.-]+)+$",
        "type": "string"
      },
      "maxItems": 200,
      "title": "Permissions",
      "type": "array"
    },
    "persona": {
      "description": "Which dashboard family the principal lands on.",
      "enum": [
        "admin",
        "tenant"
      ],
      "title": "Persona",
      "type": "string"
    },
    "principalId": {
      "pattern": "^p_[a-z0-9_]{2,60}$",
      "title": "Principalid",
      "type": "string"
    },
    "role": {
      "description": "Fixture role (approved G0 access model; DR-019). Permissions per role are fixed in specs/authorization/permissions.yaml (PR-M1).",
      "enum": [
        "PORTFOLIO_ADMIN",
        "REGIONAL_ADMIN",
        "MALL_MANAGER",
        "LEASING_MANAGER",
        "FITOUT_MANAGER",
        "TENANT_COMPANY_ADMIN",
        "TENANT_LEASE_CONTACT"
      ],
      "title": "Role",
      "type": "string"
    },
    "sessionExpiresAt": {
      "format": "date-time",
      "title": "Sessionexpiresat",
      "type": "string"
    }
  },
  "required": [
    "principalId",
    "displayName",
    "persona",
    "role",
    "grants",
    "permissions",
    "sessionExpiresAt"
  ],
  "title": "Principal v1",
  "type": "object",
  "x-generated-from": "cenomi.contracts.principal.Principal"
}
